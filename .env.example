# Copy to .env.local and fill in real values. Never commit secrets.

# App + DB runtime required
DATABASE_URL=${DATABASE_URL}

# Optional non-default pg-boss schema
PG_BOSS_SCHEMA=${PG_BOSS_SCHEMA}

# Optional app URL for links and callbacks
NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}

# Worker runtime required
WORKER_SECRET=${WORKER_SECRET}

# Required for the one-shot smoke dispatch bridge
WORKER_ENDPOINT=${WORKER_ENDPOINT}

# Optional local/integration-only settings
TEST_DATABASE_URL=${TEST_DATABASE_URL}

# Not used for the deploy smoke test yet
# Provider TBD — interface defined in src/server/contracts/storage.ts
STORAGE_BUCKET=${STORAGE_BUCKET}
STORAGE_ACCESS_KEY=${STORAGE_ACCESS_KEY}
STORAGE_SECRET_KEY=${STORAGE_SECRET_KEY}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}

NODE_ENV=development
