# Copy to .env.local and fill in real values. Never commit secrets.
#
# VERCEL APP vars — set these in Vercel project settings (or .env.local locally):
#   DATABASE_URL, PG_BOSS_SCHEMA (optional), NEXT_PUBLIC_APP_URL (optional)

# ── Vercel app (required) ────────────────────────────────────────────────────
DATABASE_URL=${DATABASE_URL}

# ── Vercel app (optional) ────────────────────────────────────────────────────
# Override the default pg-boss schema (defaults to "pgboss")
PG_BOSS_SCHEMA=${PG_BOSS_SCHEMA}
# Public app URL for links and callbacks
NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}

# ── Integration tests only ───────────────────────────────────────────────────
TEST_DATABASE_URL=${TEST_DATABASE_URL}

# ── Not used in smoke test (deferred to Shot 4+) ─────────────────────────────
# Storage provider — interface at src/server/contracts/storage.ts
# Current local/dev storage uses the app-side .storage/ filesystem
STORAGE_BUCKET=${STORAGE_BUCKET}
STORAGE_ACCESS_KEY=${STORAGE_ACCESS_KEY}
STORAGE_SECRET_KEY=${STORAGE_SECRET_KEY}

# LLM enrichment — Gemini-backed, optional
GEMINI_API_KEY=${GEMINI_API_KEY}
GEMINI_MODEL=${GEMINI_MODEL}

NODE_ENV=development
