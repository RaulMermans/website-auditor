# Copy to .env.local and fill in real values. Never commit secrets.

# ── Database (required) ──────────────────────────────────────────────────────
DATABASE_URL=${DATABASE_URL}

# Override pg-boss schema (defaults to "pgboss")
PG_BOSS_SCHEMA=${PG_BOSS_SCHEMA}

# ── Worker (required in production) ─────────────────────────────────────────
# Secret for POST /api/worker/process.
# Used by /api/worker/process. Intake triggers this endpoint server-side after audit creation.
# The manual GitHub worker-drain action also sends this as x-worker-secret for emergency recovery.
# Must be ≥16 chars. Omit to disable in local dev.
WORKER_SECRET=${WORKER_SECRET}

# ── Artifact storage ─────────────────────────────────────────────────────────
# "local" (dev only) | "vercel_blob"
# Production MUST use "vercel_blob" — "local" throws a startup error on Vercel.
STORAGE_PROVIDER=${STORAGE_PROVIDER}
# Required when STORAGE_PROVIDER=vercel_blob.
BLOB_READ_WRITE_TOKEN=${BLOB_READ_WRITE_TOKEN}

# ── API auth ─────────────────────────────────────────────────────────────────
# Shared key for POST /enrich and GET /pdf routes.
# Send as x-api-key or Authorization: Bearer <value>.
# Must be ≥16 chars. Omit to leave open (local dev only).
AUDIT_API_KEY=${AUDIT_API_KEY}

# ── Internal access gate ──────────────────────────────────────────────────────
# App-level access gate for all product and API routes.
# The deployed app is private; this gate replaces Vercel Hobby Standard Protection
# which does not protect the production domain.
# Required in production. Omit both to leave gate open (local dev only).
#
# INTERNAL_ACCESS_PASSWORD — password shown on /internal-login. Must be ≥8 chars.
INTERNAL_ACCESS_PASSWORD=${INTERNAL_ACCESS_PASSWORD}
# INTERNAL_ACCESS_COOKIE_SECRET — HMAC signing secret for the session cookie. Must be ≥32 chars.
# Generate with: openssl rand -base64 32
INTERNAL_ACCESS_COOKIE_SECRET=${INTERNAL_ACCESS_COOKIE_SECRET}

# ── Browser runtime ───────────────────────────────────────────────────────────
# "playwright" (default) | "browser_use"
BROWSER_DRIVER=${BROWSER_DRIVER}
# Required when BROWSER_DRIVER=browser_use
BROWSER_USE_BASE_URL=${BROWSER_USE_BASE_URL}
BROWSER_USE_API_TOKEN=${BROWSER_USE_API_TOKEN}

# ── LLM enrichment ────────────────────────────────────────────────────────────
GEMINI_API_KEY=${GEMINI_API_KEY}
# Defaults to gemini-2.5-flash
GEMINI_MODEL=${GEMINI_MODEL}

# ── App ───────────────────────────────────────────────────────────────────────
# Server-side base URL used by the intake action to self-call /api/worker/process.
# Set to the canonical deployment URL in production (e.g. https://yourdomain.vercel.app).
# Falls back to VERCEL_URL (Vercel-injected), then http://localhost:3000.
APP_URL=${APP_URL}
# Public base URL for client-visible links and Next.js metadata.
NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}

# ── Integration tests only ────────────────────────────────────────────────────
TEST_DATABASE_URL=${TEST_DATABASE_URL}

NODE_ENV=development
