# Copy to .env.local and fill in real values. Never commit secrets.
#
# Current app runtime contract (Vercel project settings or .env.local):
#   DATABASE_URL (canonical; POSTGRES_URL/DATABASE_URL_UNPOOLED are ignored unless copied here)
#   PG_BOSS_SCHEMA (optional; defaults to "pgboss")
#   GEMINI_API_KEY (optional; enables enrichment)
#   GEMINI_MODEL (optional; defaults to "gemini-2.5-flash")
#   NEXT_PUBLIC_APP_URL (optional)
# No WORKER_ENDPOINT / WORKER_SECRET; no external worker host is required.

# ── App runtime (required) ───────────────────────────────────────────────────
DATABASE_URL=${DATABASE_URL}

# ── App runtime (optional) ───────────────────────────────────────────────────
# Override the default pg-boss schema (defaults to "pgboss")
PG_BOSS_SCHEMA=${PG_BOSS_SCHEMA}
# Browser runtime selection (defaults to "playwright")
BROWSER_DRIVER=${BROWSER_DRIVER}
# Required only when BROWSER_DRIVER=browser_use; points at the project-owned sidecar/service
BROWSER_USE_BASE_URL=${BROWSER_USE_BASE_URL}
# Optional bearer token for the browser-use sidecar/service
BROWSER_USE_API_TOKEN=${BROWSER_USE_API_TOKEN}
# Gemini enrichment provider
GEMINI_API_KEY=${GEMINI_API_KEY}
# Defaults to gemini-2.5-flash when unset
GEMINI_MODEL=${GEMINI_MODEL}
# Public app URL for links and callbacks
NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}

# ── Integration tests only ───────────────────────────────────────────────────
TEST_DATABASE_URL=${TEST_DATABASE_URL}

NODE_ENV=development
