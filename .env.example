# Copy to .env.local and fill in real values. Never commit secrets.
#
# VERCEL APP vars — set these in Vercel project settings (or .env.local locally):
#   DATABASE_URL, PG_BOSS_SCHEMA (optional), NEXT_PUBLIC_APP_URL (optional)
#
# WORKER PROCESS vars — set these on the machine/service running the worker:
#   DATABASE_URL, WORKER_SECRET, PORT (optional)
#
# SMOKE DISPATCH vars — set these in the shell running smoke:dispatch-once:
#   DATABASE_URL, WORKER_ENDPOINT, WORKER_SECRET

# ── Vercel app (required) ────────────────────────────────────────────────────
DATABASE_URL=${DATABASE_URL}

# ── Vercel app (optional) ────────────────────────────────────────────────────
# Override the default pg-boss schema (defaults to "pgboss")
PG_BOSS_SCHEMA=${PG_BOSS_SCHEMA}
# Public app URL for links and callbacks
NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}

# ── Worker process (required) ────────────────────────────────────────────────
# DATABASE_URL is also required by the worker — set it in the worker's env
WORKER_SECRET=${WORKER_SECRET}

# ── Smoke dispatch bridge (required at dispatch time) ────────────────────────
WORKER_ENDPOINT=${WORKER_ENDPOINT}

# ── Integration tests only ───────────────────────────────────────────────────
TEST_DATABASE_URL=${TEST_DATABASE_URL}

# ── Not used in smoke test (deferred to Shot 4+) ─────────────────────────────
# Storage provider — interface at src/server/contracts/storage.ts
# Worker currently uses local .storage/ filesystem (dev-only, non-Vercel)
STORAGE_BUCKET=${STORAGE_BUCKET}
STORAGE_ACCESS_KEY=${STORAGE_ACCESS_KEY}
STORAGE_SECRET_KEY=${STORAGE_SECRET_KEY}

# LLM enrichment — deferred to Shot 6
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}

NODE_ENV=development
